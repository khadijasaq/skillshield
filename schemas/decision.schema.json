{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-skill-conformance/schemas/decision.schema.json",
  "title": "Decision",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "skill_id": { "type": "string", "minLength": 1 },
    "value": {
      "type": "string",
      "enum": ["ALLOW", "FLAG", "DENY"]
    },
    "reason_code": {
      "type": ["string", "null"],
      "enum": [
        "INVALID_DECLARATION",
        "MISSING_DECLARATION",
        "UNDECLARED_CAPABILITY",
        "POLICY_VIOLATION",
        "STATIC_RUNTIME_MISMATCH",
        "INVALID_EVENT",
        "UNKNOWN_CAPABILITY",
        "INTEGRITY_FAILURE",
        null
      ]
    }
  },
  "required": ["schema_version", "skill_id", "value"],
  "additionalProperties": false
}

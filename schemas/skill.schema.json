{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-skill-conformance/schemas/skill.schema.json",
  "title": "Skill",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "skill_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "integrity": { "type": "string", "minLength": 1 },
    "declaration": {
      "type": "object",
      "properties": {
        "declared_capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "permissions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["declared_capabilities"],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "context": { "type": "object" }
  },
  "required": [
    "schema_version",
    "skill_id",
    "name",
    "version",
    "description",
    "source",
    "integrity",
    "declaration"
  ],
  "additionalProperties": false
}

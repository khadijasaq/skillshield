{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-skill-conformance/schemas/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "reason_code": {
      "type": "string",
      "enum": [
        "INVALID_DECLARATION",
        "MISSING_DECLARATION",
        "UNDECLARED_CAPABILITY",
        "POLICY_VIOLATION",
        "STATIC_RUNTIME_MISMATCH",
        "INVALID_EVENT",
        "UNKNOWN_CAPABILITY",
        "INTEGRITY_FAILURE"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "description": { "type": "string", "minLength": 1 }
  },
  "required": ["schema_version", "reason_code", "capabilities", "evidence_refs", "description"],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-skill-conformance/schemas/assessment.schema.json",
  "title": "Assessment",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "skill_id": { "type": "string", "minLength": 1 },
    "skill_name": { "type": "string", "minLength": 1 },
    "skill_version": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "declared_capabilities": { "type": "array", "items": { "type": "string" } },
    "static_capabilities": { "type": "array", "items": { "type": "string" } },
    "runtime_capabilities": { "type": "array", "items": { "type": "string" } },
    "findings": { "type": "array", "items": { "type": "object" } },
    "policy_results": { "type": "array", "items": { "type": "object" } },
    "decision": { "type": "object" },
    "severity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"]
    },
    "recommendation": {
      "type": "string",
      "enum": ["NO ISSUES FOUND", "REVIEW BEFORE USE", "DO NOT USE"]
    }
  },
  "required": [
    "schema_version", "skill_id", "skill_name", "skill_version", "source",
    "declared_capabilities", "static_capabilities", "runtime_capabilities",
    "findings", "policy_results", "decision", "severity", "recommendation"
  ],
  "additionalProperties": false
}
